# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX).
# Leave unset locally — the Analytics component simply renders nothing without it.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console domain verification (HTML tag method) — the content
# value from https://search.google.com/search-console for the
# www.d-stellar.co property. Leave unset until that property exists; the
# meta tag simply isn't rendered without it.
GOOGLE_SITE_VERIFICATION=
