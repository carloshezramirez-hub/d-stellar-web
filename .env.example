# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX).
# Leave unset locally — the Analytics component simply renders nothing without it.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Pickup order emails (Gmail SMTP + app password, see https://myaccount.google.com/apppasswords)
# Leave unset locally — the pickup form still works, emails are just skipped with a console warning.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Where the "new pickup order" notification goes. Defaults to GMAIL_USER if unset.
NOTIFICATION_EMAIL=sweetuniversecompany@gmail.com

# Mercado Pago (Checkout Pro) for pickup order payments. Get from
# https://www.mercadopago.com.mx/developers/panel — "Credenciales de prueba"
# tab while the business account isn't verified yet, "Credenciales de
# producción" once it can receive real payments (same variable name either
# way). Leave unset locally — the pickup form falls back to "pay at pickup"
# (no online charge) and emails immediately, same as before this existed.
MP_ACCESS_TOKEN=
# Optional: the "Clave secreta" from the webhook config screen in the same
# panel, used to verify that webhook calls really come from Mercado Pago.
# Leave unset and signature verification is skipped (logged as a warning).
MP_WEBHOOK_SECRET=

# Google Search Console domain verification (HTML tag method) — the content
# value from https://search.google.com/search-console for the
# www.d-stellar.co property. Leave unset until that property exists; the
# meta tag simply isn't rendered without it.
GOOGLE_SITE_VERIFICATION=

# "Eventos privados" outbound prospecting engine (weekly cron, walkable
# radius around Nuevo León 217 — see lib/prospecting/, lib/ai/private-event-*,
# app/api/cron/{prospect,send-approved}-events). All of these are required
# for the crons to do anything; without them the routes just error out.

# Supabase — dedicated project for d-stellar's event_leads table (run
# supabase/schema.sql once against a fresh project). Service role key only,
# never exposed to the client.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Google Places API (New) + Distance Matrix API, same Google Cloud project
# as stoutlab-outreach — reuse that key. Needs both APIs enabled + billing.
GOOGLE_PLACES_API_KEY=

# Anthropic — the research agent that writes each prospect's first email.
# Reuse the same key as stoutlab-outreach.
ANTHROPIC_API_KEY=

# Resend — used for cold outreach, kept separate (different local-part) from
# the sender below (payment confirmations) so a spam complaint on one never
# affects the other's deliverability.
# NOTE: this From address references mail.d-stellar.co, a subdomain that was
# NEVER actually verified in Resend (only the root d-stellar.co is, confirmed
# 2026-10-02) — if outreach ever actually sends, it will fail exactly like
# the payments sender did until this was caught. Fix by either verifying
# mail.d-stellar.co in Resend (Domains → Add Domain → add the DNS records it
# gives you — d-stellar.co's DNS is on Vercel nameservers, so they can be
# added via the Vercel domains API) or switching this to eventos@d-stellar.co
# like the payments sender.
RESEND_API_KEY=
RESEND_FROM_EMAIL="d-stellar <eventos@mail.d-stellar.co>"

# Same Resend account as above, but an isolated sender (different local-part)
# used only for ticket + pickup payment confirmations
# (app/api/tickets/webhook, app/api/pickup/webhook). Uses the verified root
# domain. Replaced the old Gmail SMTP sender (GMAIL_USER/GMAIL_APP_PASSWORD
# below, now unused) because consumer Gmail has no deliverability guarantees
# for transactional mail — see project_dstellar_web memory for the incident
# that prompted this.
RESEND_PAYMENTS_FROM_EMAIL="d-stellar <pagos@d-stellar.co>"

# Signing secret for Resend's delivery webhook (app/api/notifications/resend-webhook) —
# marks an order as bounced/complained in web_orders automatically. Get it
# from the Resend dashboard: Webhooks → Add Endpoint →
# https://www.d-stellar.co/api/notifications/resend-webhook, events
# email.delivered/email.bounced/email.complained/email.delivery_delayed →
# copy the "Signing Secret" (starts with whsec_).
RESEND_WEBHOOK_SECRET=

# Shared secret for the two cron routes above — generate any random string
# (e.g. `openssl rand -hex 32`) and set the same value on Vercel.
CRON_SECRET=

# Dashboard de analítica social (/analytics — ver lib/social/, app/api/cron/
# social-metrics-*, app/analytics/). Reutiliza el mismo proyecto de Supabase
# de arriba (las tablas social_* viven en el mismo schema.sql).

# Contraseña compartida para entrar a /analytics. Cualquier string sirve —
# sin ella, /analytics redirige siempre a la pantalla de login sin acceso.
ANALYTICS_DASHBOARD_PASSWORD=

# Meta Graph API (Instagram + Facebook) — token de un System User de Meta
# Business Suite (no expira), con permisos instagram_basic,
# instagram_manage_insights, pages_read_engagement, pages_show_list,
# pages_read_user_content, read_insights.
# Sin esto, el cron de Meta simplemente no corre.
META_ACCESS_TOKEN=
META_IG_ACCOUNT_ID=
META_PAGE_ID=

# TikTok — no requiere token, solo el @handle público de la cuenta (el cron
# lee las métricas públicas directo del HTML del perfil).
TIKTOK_HANDLE=
